generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  staff
  customer
}

enum ProductStatus {
  active
  draft
  archived
}

enum OrderStatus {
  pending
  paid
  in_fulfillment
  fulfilled
  refunded
  cancelled
}

enum CampaignStatus {
  draft
  scheduled
  sent
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String?
  role         Role       @default(customer)
  tags         String[]   @default([])
  notes        String?
  addresses    Address[]
  orders       Order[]
  wishlist     WishlistItem[]
  reviews      Review[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  fullName  String   @default("")
  line1     String
  line2     String   @default("")
  city      String
  region    String
  postal    String
  country   String
  phone     String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  category    String
  collection  String
  color       String
  price       Int
  compareAt   Int?
  featured    Boolean          @default(false)
  status      ProductStatus    @default(active)
  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  orderItems  OrderItem[]
  wishlistedBy WishlistItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  size      String
  stock     Int     @default(0)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  email          String
  status         OrderStatus @default(pending)
  subtotal       Int
  shipping       Int
  tax            Int
  discountAmount Int         @default(0)
  discountCode   String?
  total          Int
  stripeSession  String?
  trackingNumber String?
  carrier        String?
  customerNotes  String?
  internalNote   String?
  shippingName   String?
  shippingLine1  String?
  shippingCity   String?
  shippingRegion String?
  shippingPostal String?
  shippingCountry String?
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  size      String
  quantity  Int
  unitPrice Int
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  rating    Int
  title     String
  body      String
  author    String
  createdAt DateTime @default(now())
}

model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique
  description String
  percentOff  Int
  active      Boolean   @default(true)
  timesUsed   Int       @default(0)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
}

model StaffInvite {
  id        String   @id @default(cuid())
  email     String
  role      Role
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String   @default("")
  imageUrl  String   @default("")
  ctaLabel  String   @default("")
  ctaHref   String   @default("")
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailCampaign {
  id           String         @id @default(cuid())
  name         String
  subject      String
  body         String
  audience     String         @default("All customers")
  status       CampaignStatus @default(draft)
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  countries String[] @default([])
  rate      Int      @default(0)
  freeOver  Int?
  createdAt DateTime @default(now())
}

model TaxRate {
  id        String   @id @default(cuid())
  region    String
  rate      Float
  createdAt DateTime @default(now())
}

model StoreSettings {
  id              String  @id @default("singleton")
  brandName       String  @default("RISE")
  supportEmail    String  @default("support@rise.test")
  currency        String  @default("USD")
  stripeLiveMode  Boolean @default(false)
  taxInclusive    Boolean @default(false)
  updatedAt       DateTime @updatedAt
}
